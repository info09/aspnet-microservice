      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "localhost",
          "Port": 5006
        }
      ]
    },
    {
      "UpstreamPathTemplate": "/inventory/{id}",
      "UpstreamHttpMethod": [
        "DELETE"
      ],
      "DownstreamPathTemplate": "/api/inventory/{id}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "localhost",
          "Port": 5006
        }
      ]
